{
  "name": "sigma-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "bun scripts/check.ts",
    "coverage": "bun test --timeout 30000 --path-ignore-patterns='packages/conformance/**' --reporter=junit --reporter-outfile=node_modules/.cache/coverage-junit.xml && bun scripts/coverage.ts node_modules/.cache/coverage-junit.xml",
    "format": "prettier --write .",
    "schema": "bun packages/sigma/src/main.ts schema > schema/sigma.schema.json"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@xterm/headless": "6.0.0",
    "prettier": "3.6.2",
    "typescript": "6.0.3"
  }
}
